/* KeyPresserNext — Fluent Design Dark (Win11)
 * bg #202020 / layer #2C2C2C / stroke rgba white / accent #0078D4 / radius 4
 */

QToolTip {
    color: #ffffff;
    background-color: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 14%);
    border-radius: 4px;
    padding: 4px 8px;
}

QMainWindow,
QDialog {
    background-color: #202020;
    color: #c8c8c8;
}

/* 勿给全局 QWidget 上色，否则 QLabel 会在面板上露出色块 */
QLabel {
    background: transparent;
    color: #c8c8c8;
}

QGroupBox {
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 8px;
    margin-top: 8px;
    padding: 4px 6px 4px 6px;
    background-color: #2c2c2c;
    color: #c8c8c8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #ffffff;
}

QGroupBox#bindBox {
    margin-top: 8px;
    padding: 2px 4px 4px 4px;
}

QGroupBox#testBox,
QGroupBox#modeBox {
    margin-top: 2px;
    padding: 8px 4px 4px 4px;
    background-color: rgba(0, 0, 0, 10%);
}

QGroupBox#testBox::title,
QGroupBox#modeBox::title {
    color: #b8b8b8;
    padding: 0 3px;
}

QWidget#bindField {
    background: transparent;
}

QLabel#fieldLabel {
    background: transparent;
    color: #9a9a9a;
}

QLabel#windowValue {
    color: #9a9a9a;
    background-color: rgba(0, 0, 0, 22%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    padding: 6px 10px;
}

QLabel#windowValue[bound="true"] {
    color: #ffffff;
    border-color: #0078d4;
}

QFrame#bindSep {
    background-color: rgba(255, 255, 255, 9%);
    border: none;
    max-height: 1px;
    margin: 4px 0;
}

/* 测试区：取点+测试鼠标 / 设置按键+测试键盘 */
QFrame#testActionGroup {
    background: rgba(0, 0, 0, 18%);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 4px;
    padding: 0;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 22%);
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 32%);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 22%);
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 32%);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
}

QMenuBar {
    background: transparent;
    border: none;
}

QMenuBar#titleMenuBar {
    background: transparent;
}

QMenuBar::item {
    color: #c8c8c8;
    background: transparent;
    padding: 4px 5px;
    margin: 0 1px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 6%);
    color: #ffffff;
}

QMenu {
    background: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 6px;
    color: #ffffff;
    padding: 4px;
    icon-size: 16px;
}

QMenu::item {
    padding: 4px 24px 4px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: rgba(0, 120, 212, 55%);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 9%);
    margin: 4px 8px;
}

/* Title bar — Fluent solid / mica-like */
QWidget#darkTitleBar {
    background-color: #2a2a2a;
    border-bottom: 1px solid rgba(255, 255, 255, 9%);
}

QLabel#titleLabel {
    color: #ffffff;
    background: transparent;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}

QLabel#titleIcon {
    background: transparent;
}

QPushButton#titleMinBtn,
QPushButton#titleMaxBtn,
QPushButton#titleCloseBtn {
    background: transparent;
    border: none;
    color: #ffffff;
    /* 保留代码里设置的 Segoe 图标字体，勿只写 font-size 导致回落默认字体 */
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", "Segoe UI";
    font-size: 12px;
    padding: 0;
    margin: 0;
    min-width: 46px;
    max-width: 46px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 0;
}

QPushButton#titleMinBtn:hover,
QPushButton#titleMaxBtn:hover {
    background: rgba(255, 255, 255, 6%);
    color: #ffffff;
}

QPushButton#titleCloseBtn:hover {
    background: #e81123;
    color: #ffffff;
}

QPushButton#titleCloseBtn:pressed {
    background: #c50f1f;
}

QStatusBar {
    background: #1c1c1c;
    color: #9a9a9a;
    border-top: 1px solid rgba(255, 255, 255, 9%);
}

QLineEdit {
    background: rgba(0, 0, 0, 22%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    padding: 3px 6px;
    min-height: 18px;
}

QSpinBox {
    background: rgba(0, 0, 0, 22%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    padding: 3px 20px 3px 6px;
    min-height: 18px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    height: 12px;
    margin-top: 1px;
    margin-right: 1px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    height: 12px;
    margin-bottom: 1px;
    margin-right: 1px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 8%);
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background: rgba(0, 120, 212, 45%);
}

QSpinBox::up-arrow {
    image: url(:/png/spin_up.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(:/png/spin_down.png);
    width: 10px;
    height: 10px;
}

QComboBox {
    background: rgba(0, 0, 0, 22%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    padding: 2px 20px 2px 6px;
    min-height: 18px;
    max-width: 220px;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    background: rgba(0, 0, 0, 28%);
    border-color: rgba(255, 255, 255, 14%);
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #0078d4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/png/combo_down.png);
    width: 12px;
    height: 12px;
}

QComboBox::drop-down:hover {
    background: rgba(255, 255, 255, 6%);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox QAbstractItemView {
    background: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 4px;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}

/* Fluent secondary button — 高度与 ComboBox / LineEdit 对齐 */
QPushButton {
    background: rgba(255, 255, 255, 6%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    color: #ffffff;
    padding: 2px 6px;
    min-height: 18px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 10%);
    border-color: rgba(255, 255, 255, 12%);
}

QPushButton:pressed {
    background: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton:disabled {
    color: #6d6d6d;
    background: rgba(255, 255, 255, 3%);
    border-color: rgba(255, 255, 255, 6%);
}

QPushButton#rowDeleteBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    min-height: 18px;
}

QPushButton#rowDeleteBtn:hover {
    background: rgba(232, 17, 35, 28%);
    border: none;
}

QPushButton#rowDeleteBtn:pressed {
    background: rgba(232, 17, 35, 45%);
    border: none;
}

QPushButton#btnScreenshot {
    padding: 2px 18px 2px 6px;
    text-align: left;
}

/* Fusion + QSS 下默认贴底，强制垂直居中 */
QPushButton#btnScreenshot::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 12px;
    height: 12px;
    right: 6px;
    top: 0px;
    bottom: 0px;
    image: url(:/png/combo_down.png);
}

QCheckBox,
QRadioButton {
    background: transparent;
    color: #c8c8c8;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    background-color: rgba(0, 0, 0, 25%);
    border: 1px solid #a0a0a0;
    border-radius: 3px;
}

QCheckBox::indicator:unchecked:hover {
    background-color: rgba(255, 255, 255, 6%);
    border: 1px solid #dedede;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border: 1px solid #60cdff;
    border-radius: 3px;
    image: url(:/png/check.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #1a86e0;
    border: 1px solid #60cdff;
}

QCheckBox::indicator:disabled {
    background-color: rgba(255, 255, 255, 3%);
    border: 1px solid #555555;
}

/* Fluent 单选：外圈 + 内圆点，避免整块实心蓝 */
QRadioButton::indicator:unchecked {
    border: none;
    background: transparent;
    image: url(:/png/radio_off.png);
}

QRadioButton::indicator:unchecked:hover {
    image: url(:/png/radio_off_hover.png);
}

QRadioButton::indicator:checked {
    border: none;
    background: transparent;
    image: url(:/png/radio_on.png);
}

QRadioButton::indicator:checked:hover {
    image: url(:/png/radio_on_hover.png);
}

QRadioButton::indicator:disabled {
    border: none;
    background: transparent;
    image: url(:/png/radio_off.png);
}

QLabel#mutedTip {
    color: #9a9a9a;
}

QLabel#stopHotkeyHint {
    color: #ffffff;
    background-color: rgba(44, 44, 44, 230);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 8px;
    padding: 12px 18px;
    font-size: 15px;
    font-weight: bold;
}

QToolButton#passwordEyeBtn {
    border: none;
    background: transparent;
    border-radius: 4px;
}

QToolButton#passwordEyeBtn:hover {
    background: rgba(255, 255, 255, 6%);
}

QLineEdit[capturing="true"] {
    background-color: #3a2e1a;
    border: 1px solid #bb8009;
    color: #f0c674;
}

QFrame#hlFrame {
    border: 3px solid #e81123;
    background-color: rgba(232, 17, 35, 45);
    border-radius: 4px;
}

QFrame#actionToolBar {
    background-color: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 8px;
}

QFrame#toolSep {
    background-color: rgba(255, 255, 255, 9%);
    border: none;
    max-width: 1px;
    margin: 4px 0;
}

QScrollArea#rowsScroll {
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 8px;
    background-color: #2c2c2c;
}

QWidget#rowsHost {
    background-color: #2c2c2c;
}

QFrame#logPanel {
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 8px;
    background-color: #2a2a2a;
}

QLabel#logTitle {
    color: #b0b0b0;
    font-weight: 600;
}

QPushButton#logToggleBtn {
    padding: 0;
    margin: 0;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #b0b0b0;
    font-size: 12px;
}

QPushButton#logToggleBtn:hover {
    background-color: rgba(255, 255, 255, 8%);
    color: #eaeaea;
}

QPushButton#logClearBtn {
    padding: 2px 10px;
    min-width: 48px;
}

QPlainTextEdit#logEdit {
    border: 1px solid rgba(255, 255, 255, 7%);
    border-radius: 6px;
    background-color: #1f1f1f;
    color: #c8c8c8;
    selection-background-color: #0078d4;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    padding: 4px;
}

QWidget#actionRow {
    border-bottom: 1px solid rgba(255, 255, 255, 9%);
    background-color: #323232;
}

QWidget#actionRow:hover {
    background-color: rgba(255, 255, 255, 4%);
}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 8px;
    background: #2c2c2c;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #9a9a9a;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #0078d4;
    background: transparent;
}

QTabBar::tab:hover:!selected {
    color: #c8c8c8;
    background: rgba(255, 255, 255, 4%);
    border-radius: 4px 4px 0 0;
}

QHeaderView::section {
    background: #2c2c2c;
    color: #c8c8c8;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 9%);
    border-right: 1px solid rgba(255, 255, 255, 6%);
    padding: 6px 8px;
}

QProgressBar {
    background: rgba(0, 0, 0, 22%);
    border: 1px solid rgba(255, 255, 255, 9%);
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    min-height: 8px;
}

QProgressBar::chunk {
    background: #0078d4;
    border-radius: 3px;
}
